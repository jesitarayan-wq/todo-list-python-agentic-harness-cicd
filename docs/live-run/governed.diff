@@ -1,6 +1,7 @@
 # coding=utf-8
 import mongomock
 import pytest
+from bson.errors import InvalidId
 
 from task import TaskDAO
 
@@ -117,3 +118,133 @@ def test_list_sorts_by_done_before_priority(dao):
     tasks = dao.list()
 
     assert [task['title'] for task in tasks] == ['Undone Low Task', 'Done High Task']
+
+
+def _create_task(dao):
+    return dao.create({'title': 'Old Title', 'description': 'Old Description', 'priority': 3})
+
+
+def test_update_changes_the_title(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'title': 'New Title'})
+
+    assert task['title'] == 'New Title'
+
+
+def test_update_changes_the_description(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'description': 'New Description'})
+
+    assert task['description'] == 'New Description'
+
+
+def test_update_changes_the_priority(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'priority': 1})
+
+    assert task['priority'] == 1
+
+
+def test_update_marks_task_done(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'done': True})
+
+    assert task['done'] is True
+
+
+def test_update_can_mark_task_not_done_again(dao):
+    created = _create_task(dao)
+    dao.update(created['_id']['$oid'], {'done': True})
+
+    task = dao.update(created['_id']['$oid'], {'done': False})
+
+    assert task['done'] is False
+
+
+def test_update_only_changes_the_given_fields(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'title': 'New Title'})
+
+    assert task['description'] == 'Old Description'
+    assert task['priority'] == 3
+    assert task['done'] is False
+
+
+def test_update_returns_the_updated_task_with_same_id(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'title': 'New Title'})
+
+    assert task['_id'] == created['_id']
+
+
+def test_update_persists_the_change(dao):
+    created = _create_task(dao)
+
+    dao.update(created['_id']['$oid'], {'title': 'New Title', 'done': True})
+
+    stored = dao.read(created['_id']['$oid'])
+    assert stored['title'] == 'New Title'
+    assert stored['done'] is True
+
+
+def test_update_ignores_unknown_keys(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'foo': 'bar', 'title': 'New Title'})
+
+    assert 'foo' not in task
+    stored = dao.task_collection.find_one({'title': 'New Title'})
+    assert 'foo' not in stored
+
+
+def test_update_does_not_overwrite_the_id(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {'_id': 'x', 'title': 'New'})
+
+    assert task['_id'] == created['_id']
+    assert task['title'] == 'New'
+    assert dao.task_collection.count_documents({}) == 1
+
+
+def test_update_with_empty_data_returns_task_unchanged(dao):
+    created = _create_task(dao)
+
+    task = dao.update(created['_id']['$oid'], {})
+
+    assert task == dao.read(created['_id']['$oid'])
+
+
+def test_update_returns_none_for_unknown_id(dao):
+    task = dao.update('5f9f1b9b9b9b9b9b9b9b9b9b', {'title': 'New Title'})
+
+    assert task is None
+    assert dao.task_collection.count_documents({}) == 0
+
+
+@pytest.mark.parametrize('bad_done', [1, 0, 'true', None])
+def test_update_rejects_non_boolean_done(dao, bad_done):
+    created = _create_task(dao)
+
+    with pytest.raises(ValueError):
+        dao.update(created['_id']['$oid'], {'done': bad_done})
+
+
+def test_update_does_not_apply_other_changes_when_done_is_invalid(dao):
+    created = _create_task(dao)
+
+    with pytest.raises(ValueError):
+        dao.update(created['_id']['$oid'], {'title': 'New', 'done': 'yes'})
+
+    assert dao.read(created['_id']['$oid'])['title'] == 'Old Title'
+
+
+def test_update_raises_for_invalid_object_id(dao):
+    with pytest.raises(InvalidId):
+        dao.update('abc', {'title': 'x'})
